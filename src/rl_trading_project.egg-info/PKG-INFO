    %% 1. Datos e Ingesta
    subgraph F1 ["Fase 1: Datos"]
        A["Dataset Histórico del Profesor <br> CSV: Open, High, Low, Close, Volume"] --> B["Análisis Exploratorio EDA <br> notebooks/eda.ipynb"]
        B --> C["División Temporal Estricta <br> Entrenamiento vs Held-out"]
    end

    %% 2. Entorno de Simulación
    subgraph F2 ["Fase 2: Simulación"]
        C --> D["Entorno Personalizado Lookahead-Safe <br> src/environment.py"]
        D -->|"Cálculo de Portafolio"| E["Gestión de Posiciones: 0%, 50%, 100%"]
        D -->|"Aplicación de Reglas"| F["Costos de Transacción (Basis Points)"]
        D -->|"Evaluación"| G["Función de Recompensa / Step"]
    end

    %% 3. El Agente de DRL y Baselines
    subgraph F3 ["Fase 3: Aprendizaje"]
        G -->|"Estado: Indicadores"| H["Agente DQN / Red Neuronal <br> src/agent.py"]
        H -->|"Actualización de Pesos W"| I["Script de Entrenamiento <br> src/train.py"]
        
        %% Baselines
        C --> J["Estrategias Baselines <br> src/baselines.py"]
        J --> J1["Buy and Hold"]
        J --> J2["Agente Aleatorio"]
    end

    %% 4. Evaluación y Resultados
    subgraph F4 ["Fase 4: Pruebas y Resultados"]
        I -->|"Modelo Guardado"| K["Script de Evaluación en Held-out <br> src/evaluate.py"]
        J1 --> K
        J2 --> K
        C -->|"Datos No Vistos"| K
        
        K --> L["Métricas: Retorno Acumulado, <br> Max Drawdown y Costos"]
        L --> M["Curvas de Capital y Conclusiones"]
    end
